# Vercel Docker image: same as Dockerfile but documented for the container
# deployment path. The primary Vercel deployment uses the serverless Go
# function in api/handler.go (see vercel.json); this image is the alternative
# when a long-running container is preferred and full SAST tools are needed.

FROM golang:1.22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o black-hat ./cmd/blackhat

FROM alpine:latest

RUN apk --no-cache add ca-certificates curl tar git bash \
    python3 py3-pip nodejs npm

WORKDIR /root/

COPY build.sh /build.sh
RUN bash /build.sh || true

COPY --from=builder /app/black-hat .

ENV PORT=80

EXPOSE 80

CMD ["./black-hat"]
